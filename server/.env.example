PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# 'localnet' (default) uses AlgoKit LocalNet + KMD dispenser funding.
# 'testnet' uses the public Algorand TestNet and requires manual funding — see README.
ALGO_NETWORK=localnet

# LocalNet defaults (used when ALGO_NETWORK=localnet). Leave as-is for `algokit localnet start`.
ALGOD_SERVER=http://localhost
ALGOD_PORT=4001
ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
KMD_SERVER=http://localhost
KMD_PORT=4002
KMD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# --- TestNet mode (set ALGO_NETWORK=testnet above to enable) ---
# ALGOD_SERVER / ALGOD_PORT / ALGOD_TOKEN default to AlgoNode's free public TestNet API
# (https://testnet-api.algonode.cloud) and don't need to be set unless you want a different node.
#
# Provide 25-word mnemonics for a persistent merchant treasury and demo agent so you only
# have to fund them once with real TestNet ALGO. Generate them with:
#   npm run gen:testnet-account -w server
# then paste the printed mnemonics below and send TestNet ALGO to the printed addresses
# (https://bank.testnet.algorand.network/).
# MERCHANT_MNEMONIC=word1 word2 ... word25
# AGENT_MNEMONIC=word1 word2 ... word25

